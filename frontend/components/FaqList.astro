---
import { DEFAULT_SITE_CONTENT } from "../../shared/site-content/defaults";
---

<div class="vss-faq-content">
  <div class="vss-faq-search" data-faq-search-wrap>
    <label for="faq-search">Find an answer</label>
    <input
      id="faq-search"
      type="search"
      placeholder="Try “hours” or “getting started”"
      data-faq-search
      disabled
      autocomplete="off"
    />
    <p data-faq-count role="status" aria-live="polite">Browse below or search by topic.</p>
  </div>
  <div class="vss-faqs" data-public-faqs>
    {
      DEFAULT_SITE_CONTENT.faqs
        .filter((x) => x.published)
        .map((faq) => (
          <details class="vss-faq" data-faq-id={faq.id}>
            <>
              <summary>
                {faq.question}
                <span aria-hidden="true">+</span>
              </summary>
              <p>{faq.answer}</p>
            </>
          </details>
        ))
    }
  </div>
</div>
