{
  "name": "vss-website",
  "version": "1.6.7",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "setup": "node devops/scripts/setup.mjs",
    "doctor": "node --env-file-if-exists=.env devops/scripts/doctor.mjs",
    "dev": "node devops/scripts/start.mjs",
    "dev:frontend": "node devops/scripts/dev-frontend.mjs",
    "dev:backend": "node --env-file-if-exists=.env --import tsx devops/scripts/dev-backend.ts",
    "build": "node devops/scripts/build-preflight.mjs && astro build --force && node devops/scripts/security-build.mjs && node devops/scripts/verify-build.mjs",
    "check": "astro check && tsc --noEmit",
    "verify": "npm run check && npm test && npm run build",
    "test": "vitest run",
    "test:frontend": "vitest run tests/frontend",
    "test:backend": "vitest run tests/backend",
    "test:database": "vitest run tests/database",
    "test:devops": "vitest run tests/devops",
    "test:watch": "vitest",
    "db:backup": "node --env-file-if-exists=.env devops/scripts/backup-database.mjs",
    "db:restore": "node --env-file-if-exists=.env devops/scripts/restore-database.mjs",
    "verify:deployment": "node --env-file-if-exists=.env devops/scripts/verify-deployment.mjs",
    "test:browser": "node node_modules/playwright/cli.js test",
    "dev:cloud": "node devops/scripts/start.mjs --cloud",
    "accounts": "node devops/scripts/local-accounts.mjs",
    "reset:local": "node devops/scripts/reset-local.mjs",
    "test:classroom": "vitest run tests/classroom",
    "doctor:cloud": "node --env-file-if-exists=.env devops/scripts/doctor.mjs --cloud",
    "db:prepare": "node devops/scripts/prepare-database.mjs",
    "test:browser:classroom": "node node_modules/playwright/cli.js test tests/e2e/classroom.spec.ts",
    "security:check": "node devops/scripts/security-source-check.mjs",
    "security:audit": "npm audit --audit-level=moderate"
  },
  "dependencies": {
    "@netlify/functions": "6.0.2",
    "@supabase/supabase-js": "2.117.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@electric-sql/pglite": "0.5.9",
    "@types/node": "22.20.5",
    "astro": "7.3.8",
    "happy-dom": "21.0.4",
    "playwright": "1.62.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vitest": "5.0.4"
  },
  "license": "MIT"
}
