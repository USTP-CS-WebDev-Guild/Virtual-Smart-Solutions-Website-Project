# OPTIONAL CLOUD CONFIGURATION. Default npm run dev needs none of these cloud keys.
# Fill only for npm run dev:cloud; hosting uses its own environment settings.

# FRONTEND: these public values are embedded in browser files.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
PUBLIC_TEST_ENVIRONMENT=true
PUBLIC_SITE_URL=
APP_ENV=staging

# Production: create separate staging/production Turnstile keys. Enable the same provider in
# Supabase Auth -> Attack Protection for the password sign-in endpoint.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# BACKEND: only the isolated TEST project while students work.
# Never put these values in a PUBLIC_ variable or commit .env.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
APP_ORIGIN=http://127.0.0.1:4321
RATE_LIMIT_SECRET=

# TEST EMAIL: captured in the owner workspace, never sent.
TEST_EMAIL_MODE=capture
OWNER_NOTIFY_EMAIL=owner@example.test
RESEND_FROM=Virtual Smart Solutions <hello@example.test>
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
